# Optional environment overrides for the RAG engine.
# Copy to .env and customize. All variables are optional.

OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
FLASK_HOST=127.0.0.1
FLASK_PORT=8001
MIN_KEYWORD_MATCHES=2
SOURCE_BOOST_WEIGHT=0.10
DEFINITION_BOOST_WEIGHT=0.30
